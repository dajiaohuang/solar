{
  "name": "solar",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/build-artifacts.mjs prepare && tsc -b && vite build && node ./scripts/build-artifacts.mjs finalize && node ./scripts/verify-build.mjs",
    "build:deploy": "cross-env SOLAR_ATLAS_INCLUDE_DATASET=1 npm run build",
    "build:candidate": "cross-env SOLAR_ATLAS_INCLUDE_DATASET=1 SOLAR_ATLAS_ALLOW_UNPINNED_DATASET=1 SOLAR_ATLAS_BUILD_ENV=dataset-candidate npm run build",
    "lint": "eslint . && node ./scripts/validate-yaml.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:scientific": "vitest run tests/unit/event-benchmarks.test.ts tests/unit/lambert.test.ts tests/unit/ephemeris.test.ts --reporter=json --outputFile=.cache/scientific-tests.json && node ./scripts/summarize-scientific-validation.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "npm run lint && npm run test:unit && npm run test:scientific && npm run build",
    "preprocess:asteroids": "node --max-old-space-size=4096 ./scripts/preprocess-asteroids.mjs",
    "data:lite": "cross-env MPCORB_MODE=lite MPCORB_LITE_MAX_NUMBER=30000 node ./scripts/preprocess-asteroids.mjs",
    "data:full": "cross-env MPCORB_MODE=full node --max-old-space-size=4096 ./scripts/preprocess-asteroids.mjs",
    "package:data": "node ./scripts/package-dataset.mjs ./public/data/asteroids ./asteroid-dataset.tar.gz",
    "validate:data": "node --max-old-space-size=4096 ./scripts/validate-dataset.mjs",
    "benchmark:catalog": "node ./scripts/benchmark-catalog-index.mjs",
    "check:capacity": "node ./scripts/check-capacity.mjs"
  },
  "dependencies": {
    "@types/three": "^0.184.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
